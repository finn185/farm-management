PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/hydrosmart?schema=public"
JWT_SECRET="your_jwt_secret_key"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000"
AI_SERVICE_URL="http://localhost:8000"

# ===== Nguon du lieu cam bien =====
# simulator: Tram gia lap IoT tao du lieu (demo)  |  device: nhan du lieu tu ESP32 that
DATA_SOURCE=simulator
# Tu bat gia lap khi khoi dong backend (true/false)
SIMULATOR_AUTOSTART=false
# Chu ky 1 nhip gia lap (ms)
SIMULATOR_INTERVAL_MS=2000
# Khoa bi mat thiet bi gui kem header x-device-key (de trong = khong kiem tra)
DEVICE_API_KEY=
# Thiet bi that im lang qua so ms nay -> Offline + canh bao System (mac dinh 180000 = 3 phut)
DEVICE_STALE_MS=180000
