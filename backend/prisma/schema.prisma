generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  FARM_MANAGER
  AGRONOMIST
  OPERATOR
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  fullName     String
  phoneNumber  String?
  role         Role       @default(AGRONOMIST)
  isActive     Boolean    @default(true)
  avatarUrl    String?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  auditLogs    AuditLog[]

  @@map("users")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

enum GrowthStage {
  seed
  germination
  seedling
  transplant
  vegetative
  pre_harvest
  harvest
}

enum BatchStatus {
  active
  harvested
  failed
}

model Cultivar {
  id                  String      @id @default(uuid())
  cropName            String
  name                String
  scientificName      String
  description         String
  targetCycleDays     Int         @default(35)
  expectedWeightG     Float       @default(200.0)
  
  // Dinh dưỡng & Nước (Thủy canh)
  recommendedPhMin    Float       @default(5.5)
  recommendedPhMax    Float       @default(6.5)
  recommendedEcMin    Float       @default(1.4)
  recommendedEcMax    Float       @default(2.0)
  optimalWaterTempMin Float       @default(18.0)
  optimalWaterTempMax Float       @default(24.0)
  minWaterLevelPercent Float      @default(20.0)

  // Vi khí hậu & Ánh sáng
  optimalAirTempMin   Float       @default(18.0)
  optimalAirTempMax   Float       @default(26.0)
  optimalHumidityMin  Float       @default(60.0)
  optimalHumidityMax  Float       @default(80.0)
  optimalLightPpfdMin Float       @default(150.0)
  optimalLightPpfdMax Float       @default(250.0)
  optimalLightDliMin  Float       @default(12.0)
  optimalLightDliMax  Float       @default(17.0)

  // Cấu hình thông số chi tiết theo từng giai đoạn sinh trưởng (JSON)
  stageConfigs        Json?

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  batches             CropBatch[]

  @@map("cultivars")
}

model Reservoir {
  id                  String      @id @default(uuid())
  name                String
  systemType          String      @default("NFT")
  capacityLiters      Float       @default(600.0)
  currentVolumeLiters Float       @default(540.0)
  currentPh           Float       @default(5.8)
  currentEc           Float       @default(1.7)
  currentWaterTemp    Float       @default(22.0)
  currentDo           Float?
  formulaName         String      @default("Chuẩn Hoagland - Resh")
  lastTopUpDate       String?
  lastReplacementDate String?
  pumpStatus          String      @default("running")
  aerationStatus      String      @default("active")
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  zones               FarmZone[]
  batches             CropBatch[]
  alerts              Alert[]
  waterLogs           WaterQualityLog[]
  drainEvents         SolutionDrainEvent[]
  sensors             Sensor[]

  @@map("reservoirs")
}

model FarmZone {
  id              String           @id @default(uuid())
  code            String           @unique
  name            String
  greenhouse      String           @default("Nhà màng 1")
  areaM2          Float
  slotCapacity    Int              @default(10000)
  color           String           @default("#16a34a")
  status          String           @default("growing")
  reservoirId     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  reservoir       Reservoir?       @relation(fields: [reservoirId], references: [id])
  batches         CropBatch[]
  alerts          Alert[]
  sensors         Sensor[]
  environmentLogs EnvironmentLog[]

  @@map("farm_zones")
}

model CropBatch {
  id                  String            @id @default(uuid())
  batchCode           String            @unique
  cultivarId          String
  reservoirId         String
  zoneId              String?
  systemType          String            @default("NFT")
  plantQuantity       Int
  currentQuantity     Int
  seedDate            String
  transplantDate      String
  expectedHarvestDate String
  actualHarvestDate   String?
  currentStage        GrowthStage       @default(seedling)
  status              BatchStatus       @default(active)
  densityPlantsPerM2  Float             @default(25.0)
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  cultivar            Cultivar          @relation(fields: [cultivarId], references: [id])
  reservoir           Reservoir         @relation(fields: [reservoirId], references: [id])
  zone                FarmZone?         @relation(fields: [zoneId], references: [id])
  observations        CropObservation[]
  alerts              Alert[]
  harvestRecords      HarvestRecord[]

  @@map("crop_batches")
}

model CropObservation {
  id            String    @id @default(uuid())
  batchId       String
  date          String
  avgLeafCount  Float
  avgHeightCm   Float
  sampleWeightG Float
  notes         String?
  createdAt     DateTime  @default(now())

  batch         CropBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@map("crop_observations")
}

model Alert {
  id              String      @id @default(uuid())
  severity        String      @default("warning") // emergency, critical, warning, info
  status          String      @default("open")    // open, acknowledged, resolved
  metric          String      // pH, EC, DO, Temp, WaterLevel, AirTemp, Humidity, Light, Nutrient, System
  title           String
  message         String
  suggestedAction String?
  thresholdValue  Float?
  actualValue     Float?
  unit            String?
  reservoirId     String?
  batchId         String?
  zoneId          String?
  acknowledgedBy  String?
  acknowledgedAt  DateTime?
  resolvedBy      String?
  resolvedAt      DateTime?
  resolutionNote  String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  reservoir       Reservoir?  @relation(fields: [reservoirId], references: [id])
  batch           CropBatch?  @relation(fields: [batchId], references: [id])
  zone            FarmZone?   @relation(fields: [zoneId], references: [id])

  @@map("alerts")
}

model HarvestRecord {
  id                  String     @id @default(uuid())
  batchId             String
  batchCode           String
  cultivarName        String
  harvestDate         String
  harvestedPlants     Int
  totalWeightKg       Float
  avgWeightG          Float
  rejectedWeightKg    Float      @default(0)
  aiPredictedWeightG  Float      @default(0)
  differencePercent   Float      @default(0)
  lossPercentage      Float      @default(0)
  grade               String     @default("A") // A, B, C
  unitPriceVnd        Float      @default(45000)
  totalRevenueVnd     Float      @default(0)
  notes               String?
  operatorName        String?
  createdAt           DateTime   @default(now())

  batch               CropBatch  @relation(fields: [batchId], references: [id])

  @@map("harvest_records")
}

model NutrientFormula {
  id                             String   @id @default(uuid())
  name                           String
  applicableCrop                 String
  systemType                     String   @default("NFT")
  scientificStandard             String
  targetEc                       Float
  targetPh                       Float
  dosingRatio                    String
  chemicalIncompatibilityReason  String
  stockADetails                  String
  stockBDetails                  String
  notes                          String?
  createdAt                      DateTime @default(now())

  @@map("nutrient_formulas")
}

model WaterQualityLog {
  id                 String     @id @default(uuid())
  reservoirId        String
  ph                 Float
  ec                 Float
  waterTemp          Float
  doLevel            Float?
  waterLevelPercent  Float?
  recordedBy         String?
  source             String     @default("sensor") // sensor, manual
  createdAt          DateTime   @default(now())

  reservoir          Reservoir  @relation(fields: [reservoirId], references: [id])

  @@map("water_quality_logs")
}

model SolutionDrainEvent {
  id                  String     @id @default(uuid())
  reservoirId         String
  batchId             String?
  drainDate           String
  volumeDrainedLiters Float
  finalPh             Float
  finalEc             Float
  finalDo             Float?
  reason              String     // end_of_batch, salt_accumulation, contamination, maintenance
  operator            String
  notes               String?
  createdAt           DateTime   @default(now())

  reservoir           Reservoir  @relation(fields: [reservoirId], references: [id])

  @@map("solution_drain_events")
}

model Sensor {
  id            String      @id @default(uuid())
  code          String      @unique
  name          String
  sensorType    String      // ph, ec, water_temp, do, water_level, air_temp, humidity, light, multi
  status        String      @default("online") // online, offline, warning, error, calibrating
  reservoirId   String?
  zoneId        String?
  lastReading   Float?
  unit          String?
  lastSeenAt    DateTime?   @default(now())
  batteryLevel  Float?      @default(100.0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  reservoir     Reservoir?  @relation(fields: [reservoirId], references: [id])
  zone          FarmZone?   @relation(fields: [zoneId], references: [id])

  @@map("sensors")
}

model EnvironmentLog {
  id          String    @id @default(uuid())
  zoneId      String?
  airTemp     Float
  humidity    Float
  co2         Float?
  ppfd        Float?
  dli         Float?
  vpd         Float?
  recordedBy  String?   @default("sensor")
  source      String    @default("sensor") // sensor, manual
  createdAt   DateTime  @default(now())

  zone        FarmZone? @relation(fields: [zoneId], references: [id])

  @@map("environment_logs")
}

